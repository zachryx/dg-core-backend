# Database Configuration
MONGO_URI=mongodb://localhost:27017/digitextile

# Mailer Configuration
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_USERNAME=your-email@example.com
MAILER_PASSWORD=your-email-password
MAILER_FROM_MAILER=noreply@digitextile.com

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here
SESSION_SECRET=your-session-secret-key-here
SALT_ROUND=10

# Super Admin Account (optional)
# Created on startup only when both are set and no account uses ADMIN_EMAIL.
# Left blank on purpose so a copied example never creates an admin with a known password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3 Configuration
D_AWS_REGION=us-east-1
D_AWS_ACCESS_KEY_ID=your-aws-access-key-id
D_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
D_AWS_BUCKET_NAME=your-bucket-name

# Application Configuration
PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

